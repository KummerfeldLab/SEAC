Package: SEAC
Type: Package
Title: KD-Tree Quality Control and Gene-Set Co-Localization for Visium HD
Version: 0.99.3
Authors@R: c(
    person("Yinzhao", "Wang", role = c("aut", "cre"),
           email = "wan00232@umn.edu",
           comment = "Kummerfeld Lab, University of Minnesota"),
    person("Erich", "Kummerfeld", role = "ctb",
           comment = "Methodology and scientific supervision"),
    person("Leland", "Williams", role = "ctb",
           comment = "Original Python VisHD implementation and methodology")
